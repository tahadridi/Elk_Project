# Copy this file to .env and adjust the values before running docker compose.
# The real .env is git-ignored and MUST NOT be committed.

# Elastic Stack version (keep Elasticsearch, Kibana and Logstash in sync)
ELASTIC_VERSION=8.19.0

# MongoDB credentials (application storage)
MONGO_USER=sm_admin
MONGO_PASSWORD=change-me-mongo
MONGO_DB=security_monitoring

# Redis password (login attempts / temporary IP blocking)
REDIS_PASSWORD=change-me-redis

# Flask / JWT secrets (generate strong random values for any shared environment)
FLASK_SECRET_KEY=change-me-flask-secret
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_MINUTES=60

# Seeded application users (change before running the stack)
ADMIN_PASSWORD=ChangeMe-Admin-123!
ANALYST_PASSWORD=ChangeMe-Analyst-123!
USER_PASSWORD=ChangeMe-User-123!

# Upload and authentication policy defaults
MAX_UPLOAD_MB=100
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_MINUTES=15

# GeoIP country policy
MAXMIND_LICENSE_KEY=
GEOIP_ENFORCEMENT_ENABLED=true
GEOIP_FAIL_MODE=open
DEFAULT_ALLOWED_COUNTRIES=TN,FR,DE
ALLOW_PRIVATE_IPS=true
TRUSTED_PROXIES=
